# Upstash Redis REST API credentials (dapat diambil dari console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Secret authorization untuk endpoint /api/tick (wajib diisi dan di-set di Vercel Env Vars)
CRON_SECRET=your_secure_cron_secret_key_here

# Mode eksekusi bot: 'dry-run' (simulasi orderbook nyata, tanpa uang riil)
BOT_MODE=dry-run

# Modal awal virtual dalam IDR
INITIAL_BALANCE_IDR=100000000
